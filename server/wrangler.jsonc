{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "md",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "BACKEND_BASE_URL": "http://localhost:8787/api/v1",
    "FRONTEND_URL": "http://localhost:5173",
    "SESSION_TTL_SECONDS": "2592000", // 30 days
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "DATABASE_URL_POOLED",
      "UPSTASH_REDIS_REST_URL",
      "UPSTASH_REDIS_REST_TOKEN",
    ],
  },
  "env": {
    "production": {
      "ratelimits": [
        {
          "name": "AUTH_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "API_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "BACKEND_BASE_URL": "https://md.aayushmaansoni-dev.workers.dev/api/v1",
        "FRONTEND_URL": "https://md.aayushmaansoni.com",
        "SESSION_TTL_SECONDS": "2592000", // 30 days
      },
      "secrets": {
        "required": [
          "DATABASE_URL",
          "DATABASE_URL_POOLED",
          "UPSTASH_REDIS_REST_URL",
          "UPSTASH_REDIS_REST_TOKEN",
        ],
      },
      "r2_buckets": [
        {
          "binding": "IMAGES_BUCKET",
          "bucket_name": "md-images",
        },
      ],
    },
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "md-images-dev",
    },
  ],
  "triggers": {
    "crons": ["0 3 * * *"], // daily at 03:00 UTC — purge expired sessions
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
