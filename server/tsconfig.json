{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ESNext"],
    "jsxImportSource": "hono/jsx",
    "types": ["./worker-configuration.d.ts", "node"]
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"],
  "exclude": ["scripts/**"]
}
